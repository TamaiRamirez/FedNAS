# Include a base image
FROM ubuntu:22.04
# Add vscode user with same UID and GID as your host system
# (copied from https://code.visualstudio.com/remote/advancedcontainers/add-nonroot-user#_creating-a-nonroot-user)

ARG USERNAME
ARG USER_UID
ARG USER_GID=$USER_UID

ARG DEBIAN_FRONTEND=noninteractive

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd -s /bin/bash --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && apt-get update \
    && apt-get install -y sudo \
    && echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# Switch from root to user

# Update all packages
RUN apt update

# Install Git, vim, and nano
RUN apt install -y git vim nano

RUN apt install -y \
    build-essential \
    python3-dev \
    python3-pip \
    python3-venv \
    libopenblas-dev \
    liblapack-dev \
    libjpeg-dev \
    libpng-dev \
    libprotobuf-dev \
    protobuf-compiler \
    ffmpeg \
    libsm6 \
    libxext6 \
    libgl1-mesa-glx\
    && rm -rf /var/lib/apt/lists/*

# RUN sudo apt-get install -y nvidia-cuda-toolkit
RUN pip install --upgrade pip setuptools wheel
RUN pip install --no-cache-dir absl-py scikit-learn np_utils pandas hydra-core memory_profiler \
	"numpy<2" "protobuf<5" "flwr[simulation]>=1.16.0" "flwr-datasets[vision]>=0.5.0" "tensorflow[and-cuda]==2.16.2" 

USER $USERNAME

